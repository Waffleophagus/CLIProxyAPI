# Optional environment for CLIProxyAPI. Copy to `.env` (loaded from the working
# directory, or via `env_file` in docker-compose.yml) and uncomment what you need.

# Enables /v8/management with this key even when management.secret-key is empty.
# MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# Container timezone (defaults to UTC).
# TZ=America/Chicago
